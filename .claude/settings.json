    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git rebase *)",
      "Bash(pnpm payload migrate)",
      "Bash(pnpm payload migrate:down *)",
      "Bash(pnpm payload migrate:fresh *)",
      "Bash(pnpm payload migrate:reset *)",
      "Bash(pnpm exec tsx src/db/apply-rls.ts *)",
