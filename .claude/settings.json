      "Bash(pnpm test *)",
      "Bash(pnpm dev *)",
      "Bash(pnpm seed *)",
      "Bash(pnpm payload migrate:status *)",
      "Bash(pnpm payload migrate:create *)",
      "Bash(pnpm payload generate:types *)",
      "Bash(pnpm payload generate:importmap *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
